---
import "../styles/global.css";

// og:image debe ser URL absoluta: sale de `site` en astro.config.mjs.
const ogImage = new URL("/og.jpg", Astro.site).href;

const experiencia = [
  { n: "01", t: "Entrenamiento", d: "Peso libre, integrado y cardio", img: "/img/site/galeria-1.jpg" },
  { n: "02", t: "Technogym", d: "Equipamiento de última generación", img: "/img/technogym.jpg" },
  { n: "03", t: "Biostrength", d: "Fuerza con inteligencia artificial", img: "/img/site/biostrength-tg.jpg" },
  { n: "04", t: "Alto rendimiento", d: "Programas de progresión medida", img: "/img/rack.jpg" },
  { n: "05", t: "Contorno Pilates", d: "Reformer en la terraza acristalada", img: "/img/site/pilates-tg.jpg" },
  { n: "06", t: "Recovery", d: "Sauna y cámara hiperbárica", img: "/img/site/sauna-camara-tg.jpg" },
  { n: "07", t: "Nutrición", d: "Acompañamiento y medición", img: "/img/lounge.jpg" },
  { n: "08", t: "Coworking", d: "Tu jornada, dentro del club", img: "/img/site/coworking-tg.jpg" },
];

const conceptos = [
  { t: "Peso libre", d: "Racks, mancuernas y platos olímpicos repartidos en tres plantas.", img: "/img/peso-libre.jpg" },
  { t: "Technogym", d: "La línea completa, con login en cada aparato y registro de cada serie.", img: "/img/technogym.jpg" },
  { t: "Biostrength", d: "Fuerza con carga que se ajusta a tu nivel real en cada repetición.", img: "/img/site/biostrength-tg.jpg" },
  { t: "Alto rendimiento", d: "Programas de progresión medida para quien entrena con objetivo.", img: "/img/rack.jpg" },
  { t: "Contorno Pilates", d: "Reformer y trabajo de suelo en la terraza acristalada.", img: "/img/site/pilates-tg.jpg" },
  { t: "Recovery", d: "Sauna, cámara hiperbárica y masaje de descarga en Oasis.", img: "/img/site/sauna-camara-tg.jpg" },
  { t: "Nutrición", d: "Acompañamiento y medición, con the lab a pie de sala.", img: "/img/lounge.jpg" },
  { t: "Coworking", d: "Tu jornada entera dentro del club, con Latte Latte al lado.", img: "/img/site/coworking-tg.jpg" },
];

/* Universo flotante: TODO el pool de fotos, repartido en 3D con un hash
   determinista (mismo cielo en cada build; nada de Math.random en runtime). */
const uniFotos = [
  "recepcion","escaleras","lamparas","cardio","cardio-sala","maquinas","peso-libre","rack","funcional","technogym",
  "gym-wide","vestidores","lockers","tocador","lavabos","sauna","sauna-detalle","spa","terraza","coworking",
  "lounge","sala-privada","trainer","biostrength","barbell-setup","fachada-noche","fachada-entrada","walk-light","gym-dark","portrait",
  "training","deadlift","sprint","grip","chalk-hands","situps","situps2","medball","scream","runners",
  "rope-back","rope-jump","chalk-plate","battle-ropes","pilates",
].map((n, i) => {
  const r = (k: number) => {
    const s = Math.sin(i * 127.1 + k * 311.7) * 43758.5453;
    return s - Math.floor(s);
  };
  return {
    // versión ligera: la nube las muestra pequeñas y a resolución completa
    // eran 11 MB de textura para tarjetas de trescientos píxeles
    src: `/img/uni/${n.split("/").pop()}.jpg`,
    x: (3 + r(1) * 88).toFixed(1),
    y: (6 + r(2) * 78).toFixed(1),
    z: -(120 + r(3) * 2300).toFixed(0),
    w: (9 + r(4) * 9).toFixed(1),
    b: (6 + r(5) * 6).toFixed(1),
    a: r(6) > 0.55 ? "3 / 4" : "4 / 3",
  };
});

const oasisServicios = [
  { n: "01", t: "CONTRASTES", d: "Cold plunge · Sauna" },
  { n: "02", t: "MASAJES", d: "Descarga y recuperación" },
  { n: "03", t: "CÁMARA HIPERBÁRICA", d: "Oxigenación profunda" },
  { n: "04", t: "LONGEVITY", d: "Protocolos de largo plazo" },
  { n: "05", t: "TERAPIA DE COMPRESIÓN", d: "Circulación y drenaje" },
];

const iso = `<svg viewBox="0 0 1346 1152" aria-hidden="true"><g fill="currentColor"><rect x="2180" y="1339.3" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 2563.5 1416)"/><rect x="2832" y="1588.3" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 3215.5 1665)"/><rect x="2137.4" y="1839.8" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 2521 1916.5)"/></g></svg>`;

// lockup horizontal oficial: la palabra y el isotipo a su DERECHA (portada
// del brandbook); a la izquierda no es el logo (observación de Enrique)
const stamp = `<span class="stamp" aria-hidden="true"><b>DINAMO</b>${iso}</span>`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DINAMO — Gym &amp; Active Hub · Polanco</title>
    <meta
      name="description"
      content="DINAMO. Un santuario contemporáneo del bienestar en Polanco: entrenamiento de alto rendimiento con Technogym, recovery, pilates y coworking. Energía activa que transforma."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.site} />
    <!-- previsualización al compartir (WhatsApp, iMessage, redes): logo oficial
         sobre negro de marca. Si no hay og:image, WhatsApp inventa una tarjeta. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DINAMO" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content="DINAMO — Gym | Active Hub · Polanco" />
    <meta property="og:description" content="YOU VS YOU. Entrenamiento de alto rendimiento con Technogym, recovery, pilates y coworking en Polanco." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DINAMO — Gym | Active Hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="DINAMO — Gym | Active Hub · Polanco" />
    <meta name="twitter:description" content="YOU VS YOU. Entrenamiento de alto rendimiento con Technogym, recovery, pilates y coworking en Polanco." />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/AcuminVariableConcept.otf" as="font" type="font/otf" crossorigin />
  </head>

  <body>
    <!-- precargador: se retira solo aunque el script falle, para no dejar
         la página tapada nunca -->
    <div class="pre" id="pre" aria-hidden="true">
      <canvas id="preGl" class="pre-gl"></canvas>
      <div class="pre-inner">
        <p class="pre-word" id="preWord" aria-hidden="true"><b class="pre-l" style="--li:0">D</b><b class="pre-l" style="--li:1">I</b><b class="pre-l" style="--li:2">N</b><b class="pre-l" style="--li:3">A</b><b class="pre-l" style="--li:4">M</b><b class="pre-l" style="--li:5">O</b></p>
      </div>
    </div>

    <header class="hd" id="hd">
      <button class="hd-burger" id="hdBurger" type="button"
              aria-controls="menu" aria-expanded="false" aria-label="Abrir el menú">
        <span></span><span></span>
      </button>

      <a class="hd-logo" href="#top" aria-label="DINAMO — inicio">
        <b>DINAMO</b>
        <Fragment set:html={iso} />
      </a>

      <a class="hd-cta" href="#contacto" data-magnet>Agenda tu visita</a>
    </header>

    <!-- menú a pantalla completa -->
    <div class="menu" id="menu" aria-hidden="true">
      <nav class="menu-nav" aria-label="Secciones">
        <a href="#club" data-sec="club" style="--i:0"><i>El club</i></a>
        <a href="#experiencia" data-sec="experiencia" style="--i:1"><i>Experiencia</i></a>
        <a href="#conceptos" data-sec="conceptos" style="--i:2"><i>Conceptos</i></a>
        <a href="#espacio" data-sec="espacio" style="--i:3"><i>El espacio</i></a>
        <a href="#recovery" data-sec="recovery" style="--i:4"><i>Recovery</i></a>
        <a href="#journey" data-sec="journey" style="--i:5"><i>La app</i></a>
        <a href="#ecosistema" data-sec="ecosistema" style="--i:6"><i>Ecosistema</i></a>
        <a href="#membresias" data-sec="membresias" style="--i:7"><i>Membresías</i></a>
        <a href="#thelab" data-sec="thelab" style="--i:8"><i>the lab</i></a>
        <a href="#oasis" data-sec="oasis" style="--i:9"><i>OASIS</i></a>
      </nav>

      <div class="menu-foot">
        <div>
          <h5>Visítanos</h5>
          <a href="https://maps.app.goo.gl/v3Rkb4XRLqAzPhHC7" target="_blank" rel="noopener">Anatole France 146<br />Polanco · CDMX</a>
        </div>
        <div>
          <h5>Contacto</h5>
          <a href="tel:+525528963255">55 2896 3255</a>
          <a href="mailto:hola@dinamo.fit">hola@dinamo.fit</a>
        </div>
        <div>
          <h5>Síguenos</h5>
          <a href="https://instagram.com/dinamo_mexico" target="_blank" rel="noopener">@dinamo_mexico</a>
        </div>
      </div>
    </div>

    <main id="top">
      <!-- ═══════ HERO ═══════ -->
      <section class="sec hero" id="hero" data-theme="light">
        <div class="hero-bg" aria-hidden="true">
          <canvas id="heroGl" class="hero-gl"></canvas>
          <span class="hb hb-iso" data-depth="1.6"><Fragment set:html={iso} /></span>
          <span class="hb hb-rules" data-depth="1"></span>
          <span class="hb hb-floor"></span>
        </div>
        <div class="hero-figure" data-depth="0.35" aria-hidden="true">
          <!-- móvil: recorte con alfa de la corredora nueva (pelo entero, sin el
               corte recto del recorte de escritorio); escritorio: el de siempre -->
          <picture>
            <source media="(max-width: 900px)" srcset="/img/site/corredora-mobile.png" />
            <img decoding="async" src="/img/site/atleta-light.png" alt="" fetchpriority="high" />
          </picture>
        </div>

        <div class="hero-inner">
          <h1 class="hero-claim rv" data-lines style="--d:1">
            Active energy<br />that <em>transforms</em>.
          </h1>
          <div class="hero-foot">
            <p class="small">
              A contemporary sanctuary for wellbeing.<br />
              Training, recovery and community under one roof.
            </p>
            <a class="hero-scroll" href="#club"><i></i><span>Discover</span></a>
          </div>
        </div>
      </section>

      <!-- ═══════ MANIFIESTO ═══════ -->
      <section class="sec manifest pad-y wrap bg-bone" id="club" data-theme="light">
        <div class="manifest-head">
          <h2 class="display rv" data-lines style="--d:1">
            Redefinimos el estándar<br />del <em>fitness</em> tradicional.
          </h2>
          <div class="sec-mark rv" style="--d:2"><Fragment set:html={iso} /></div>
        </div>
        <div class="manifest-grid">
          <p class="lede rv" style="--d:2">
            Equipos y tecnología de vanguardia, entrenadores altamente
            especializados y un enfoque holístico que abarca desde el alto
            rendimiento hasta prácticas de equilibrio. Arquitectura de líneas
            limpias, materiales nobles y una atmósfera cuidadosamente curada:
            cada visita es una experiencia estética y sensorial.
          </p>
          <div class="manifest-figures rv" style="--d:3">
            <div class="figure">
              <b data-count="3">3</b>
              <span>Pisos</span>
            </div>
            <div class="figure">
              <b data-count="40" data-prefix="+">+40</b>
              <span>Clases / semana</span>
            </div>
            <div class="figure">
              <b>24/7</b>
              <span>Acceso</span>
            </div>
          </div>
        </div>

        <!-- collage en cruz: interiores a distintas profundidades -->
        <div class="cross" aria-label="Interiores del club">
          <div class="cross-t t1 media rv-img" data-depth="0.22"><img decoding="async" src="/img/recepcion.jpg" alt="Recepción" loading="lazy" /></div>
          <div class="cross-t t2 media rv-img" data-depth="0.26" style="--d:1"><img decoding="async" src="/img/maquinas.jpg" alt="Sala de peso integrado" loading="lazy" /></div>
          <div class="cross-t t3 media rv-img" data-depth="0.5" style="--d:2"><img decoding="async" src="/img/lamparas.jpg" alt="Lámparas de la recepción" loading="lazy" /></div>
          <div class="cross-t t4 media rv-img" data-depth="0.1" style="--d:1"><img decoding="async" src="/img/terraza.jpg" alt="Terraza acristalada" loading="lazy" /></div>
          <div class="cross-t t5 media rv-img" data-depth="0.26" style="--d:2"><img decoding="async" src="/img/cardio-sala.jpg" alt="Sala de cardio" loading="lazy" /></div>
          <div class="cross-t t6 media rv-img" data-depth="0.5" style="--d:3"><img decoding="async" src="/img/spa.jpg" alt="Spa" loading="lazy" /></div>
          <div class="cross-t t7 media rv-img" data-depth="0.22" style="--d:2"><img decoding="async" src="/img/vestidores.jpg" alt="Vestidores" loading="lazy" /></div>
          <div class="cross-t t8 media rv-img" data-depth="0.45" style="--d:3"><img decoding="async" src="/img/funcional.jpg" alt="Zona funcional" loading="lazy" /></div>
        </div>
      </section>

      <div class="bg-bone"><div class="wrap"><div class="rule rv"><svg class="mark" viewBox="0 0 1346 1152" aria-hidden="true"><rect x="2180" y="1339.3" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 2563.5 1416)"/><rect x="2832" y="1588.3" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 3215.5 1665)"/><rect x="2137.4" y="1839.8" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 2521 1916.5)"/></svg></div></div></div>

      <!-- ═══════ BANDA · RECEPCIÓN ═══════ -->
      <section class="sec band band-light" data-theme="dark">
        <div class="media still rv-img" data-rv="wipel" style="--pos: 50% 62%">
          <img decoding="async" src="/img/escaleras.jpg" alt="Recepción y escalera principal de DINAMO" loading="lazy" />
          <Fragment set:html={stamp} />
          </div>
        <div class="band-cap">
          <h3 class="rv">La llegada marca el tono<br />de todo lo que sigue.</h3>
          <p class="small rv" style="--d:1">Recepción · Anatole France 146</p>
        </div>
      </section>

      <!-- ═══════ FRANJA DE DISCIPLINAS ═══════ -->
      <div class="strip" aria-hidden="true">
        <p>
          <span>Peso libre — Peso integrado — Cardio — Alto rendimiento — Pilates — Recovery — Nutrición — Coworking — </span>
          <span>Peso libre — Peso integrado — Cardio — Alto rendimiento — Pilates — Recovery — Nutrición — Coworking — </span>
        </p>
      </div>

      <!-- ═══════ YOU VS YOU ═══════ -->
      <section class="sec creed dark bg-ink" data-theme="dark">
        <div class="creed-media rv-img" data-rv="wiper" data-par="0.14" aria-hidden="true">
          <img decoding="async" src="/img/site/sprinter-brandbook.jpg" alt="" loading="lazy" />
        </div>
        <!-- el isotipo COMPLETO (tres barras) a gran escala, como en la portada
             del brandbook: cada barra con la cola (extremo inferior izquierdo)
             fundida a blanco. Son los mismos rect del logo, así que las
             proporciones son las oficiales. -->
        <div class="bars rv" data-rv="bars" aria-hidden="true">
          <svg viewBox="0 0 1346 1152" aria-hidden="true">
            <defs>
              <linearGradient id="barsGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#ffffff" />
                <stop offset="0.5" stop-color="#ffe700" />
                <stop offset="1" stop-color="#ffe700" />
              </linearGradient>
            </defs>
            <g fill="url(#barsGrad)">
              <rect x="2180" y="1339.3" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 2563.5 1416)"/>
              <rect x="2832" y="1588.3" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 3215.5 1665)"/>
              <rect x="2137.4" y="1839.8" width="767" height="153.4" transform="translate(-2196 -1091) rotate(-45 2521 1916.5)"/>
            </g>
          </svg>
        </div>
        <div class="wrap creed-inner">
          <p class="creed-line rv" data-lines style="--d:1">
            La única competencia<br />eres <em>tú</em>.
          </p>
          <p class="creed-tag rv" style="--d:2">You&nbsp;vs&nbsp;You</p>
          <!-- el isotipo cierra el bloque abajo a la derecha, como el logo de la
               portada; encima del titular caía sobre el cuerpo del velocista y
               se perdían barras (captura de Angel) -->
          <div class="sec-mark creed-mark rv" style="--d:3"><Fragment set:html={iso} /></div>
        </div>
      </section>

      <!-- ═══════ EXPERIENCIA ═══════ -->
      <section class="sec exp pad-y bg-bone" id="experiencia" data-theme="light">
        <!-- isotipo grandote de fondo, esquina superior derecha -->
        <div class="exp-bgmark rv" aria-hidden="true" data-par="0.12"><Fragment set:html={iso} /></div>
        <div class="wrap">
          <div class="exp-head">
            <div>
              <h2 class="display rv" data-lines style="--d:1">Todo lo que necesitas,<br />bajo un mismo techo.</h2>
            </div>
            <p class="small rv" style="--d:2">Ocho disciplinas.<br />Un solo lugar.</p>
          </div>

          <div class="exp-body">
            <ul class="exp-list">
              {experiencia.map((e, i) => (
                <li class={`exp-item rv ${i === 0 ? "on" : ""}`} style={`--d:${i}`} data-exp={i}>
                  <button type="button">
                    <span class="exp-n">{e.n}</span>
                    <span class="exp-t">{e.t}</span>
                    <span class="exp-d">{e.d}</span>
                  </button>
                </li>
              ))}
            </ul>
            <figure class="exp-viewer" id="expViewer">
              {experiencia.map((e, i) => (
                <img decoding="async" src={e.img} alt={e.t} class={i === 0 ? "on" : ""} loading="lazy" />
              ))}
            </figure>
          </div>
        </div>
      </section>

      <!-- ═══════ TECHNOGYM ═══════ -->
      <section class="sec split dark bg-ink" data-theme="dark">
        <div class="media rv-img" data-par="0.1">
          <img decoding="async" src="/img/maquinas.jpg" alt="Sala de máquinas Technogym" loading="lazy" />
          <Fragment set:html={stamp} />
          </div>
        <div class="split-copy">
          <h2 class="display rv" data-lines style="--d:1">Technogym.<br />El estándar del <em>alto rendimiento</em>.</h2>
          <p class="lede rv" style="--d:2">
            Cada pieza del equipamiento está seleccionada para medir, ajustar y
            acelerar tu progreso. Biostrength adapta la carga a tu fuerza real
            en cada repetición, y la app de DINAMO conserva el registro de todo
            tu recorrido.
          </p>
        </div>
      </section>

      <!-- ═══════ UN DÍA ═══════ -->
      <section class="sec pad-y wrap bg-bone" data-theme="light">
        <h2 class="display rv" data-lines style="--d:1">Entrena. Recupérate.<br /><em>Conecta</em>.</h2>
        <div class="day-grid">
        <ol class="day">
          <li class="day-row rv" data-rv="left">
            <span class="day-h">06:00</span>
            <span class="day-t">Primer turno</span>
            <span class="day-d">Fuerza, alto rendimiento o tu clase de la mañana</span>
          </li>
          <li class="day-row rv" data-rv="left" style="--d:1">
            <span class="day-h">07:30</span>
            <span class="day-t">The Lab</span>
            <span class="day-d">Shake post-entreno formulado al gramo</span>
          </li>
          <li class="day-row rv" data-rv="left" style="--d:2">
            <span class="day-h">10:00</span>
            <span class="day-t">Coworking</span>
            <span class="day-d">Tu jornada sin salir del club, con Latte Latte al lado</span>
          </li>
          <li class="day-row rv" data-rv="left" style="--d:3">
            <span class="day-h">19:00</span>
            <span class="day-t">Oasis</span>
            <span class="day-d">Sauna, cámara hiperbárica o masaje de descarga</span>
          </li>
          <li class="day-row rv" data-rv="left" style="--d:4">
            <span class="day-h">21:00</span>
            <span class="day-t">Comunidad</span>
            <span class="day-d">Gente que comparte tu nivel de exigencia</span>
          </li>
        </ol>
        <!-- marco fijo: la foto de cada fila se despliega aquí al pasar el cursor -->
        <div class="day-peek rv-img" aria-hidden="true">
          <img decoding="async" src="/img/peso-libre.jpg" alt="" loading="lazy" />
          <img decoding="async" src="/img/lounge.jpg" alt="" loading="lazy" />
          <img decoding="async" src="/img/coworking.jpg" alt="" loading="lazy" />
          <img decoding="async" src="/img/sauna.jpg" alt="" loading="lazy" />
          <img decoding="async" src="/img/terraza.jpg" alt="" loading="lazy" />
        </div>
        </div>
      </section>

      <!-- ═══════ CONCEPTOS · carrusel a sangre ═══════ -->
      <section class="sec cc dark bg-ink" id="conceptos" data-theme="dark">
        <div class="wrap cc-head">
          <h2 class="display rv" data-lines style="--d:1">Ocho formas<br />de entrenar <em>aquí</em>.</h2>
          <p class="lede rv" style="--d:2">
            Del peso libre al pilates, del alto rendimiento a la recuperación:
            cada disciplina tiene su espacio, su equipamiento y su equipo. Esto
            es lo que encuentras dentro del club.
          </p>
        </div>

        <div class="cc-track" id="ccTrack" tabindex="0" role="group" aria-label="Conceptos del club">
          {conceptos.map((c, i) => (
            <article class="cc-card rv" data-rv="scale" style={`--d:${Math.min(i, 3)}`}>
              <div class="cc-media">
                <img decoding="async" src={c.img} alt={c.t} loading="lazy" draggable="false" />
              </div>
              <div class="cc-body">
                <h3>{c.t}</h3>
                <p>{c.d}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="wrap cc-nav">
